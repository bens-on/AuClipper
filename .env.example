# Copy to .env and fill in keys you have.
# Recommended minimum for a real run: ONLY Anthropic (Claude web research + concepts + captions).
# Stock/voice fall back to local ffmpeg/TTS when other keys are empty.
# Fully key-free demo: python -m orchestrator.run_pipeline --smoke

# REQUIRED for live (non-smoke) runs without YouTube/Reddit:
ANTHROPIC_API_KEY=

# Optional classic trend APIs (not needed if Anthropic is set)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AuCl/0.1 by your_username

# Optional stock footage (falls back to local generated video if empty)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional voice (falls back to Piper/ffmpeg if empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional AI video (stubbed in Phase 1)
RUNWAY_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=
