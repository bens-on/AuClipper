# LLM (concept planner + caption/hashtag copy)
ANTHROPIC_API_KEY=

# Stock footage
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice (ElevenLabs preferred when set; Piper local fallback for --smoke)
